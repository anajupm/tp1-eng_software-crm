{
  "name": "nexo-crm-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "node --test src/domain/*.test.js src/services/*.test.js src/components/*.test.js",
    "test:coverage": "node --test --experimental-test-coverage --test-coverage-exclude=**/*.test.js --test-coverage-exclude=**/*test-support.js src/domain/*.test.js src/services/*.test.js src/components/*.test.js",
    "test:e2e": "node --test --test-concurrency=1 e2e/*.test.js"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.13",
    "@vitejs/plugin-react": "^5.0.0",
    "jsdom": "^31.0.1",
    "vite": "^7.0.0"
  }
}
